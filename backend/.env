# Environment Variables for RikSahayak Backend

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Firebase Configuration
# Get your credentials from Firebase Console > Project Settings > Service Accounts
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_DATABASE_URL=your_firebase_database_url_here

# Firestore Emulator (development)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_PROJECT_ID=riksahyak-demo

# API Configuration
DEBUG=True

# MapmyIndia (Mappls) API Configuration
# Static Key for testing (Cloud apps may also require OAuth2)
MAPPLS_API_KEY=wnylajstcnsxhrsaeilklxfacdyrtlufjvgg
# MAPPLS_CLIENT_ID=YOUR_CLIENT_ID_HERE
# MAPPLS_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE
