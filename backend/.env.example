# RikSahayak Backend Environment Variables

# MapmyIndia (Mappls) API Configuration
# Get your FREE API keys from: https://mappls.com/api
# FREE tier: 10,000 requests/month
MAPPLS_API_KEY=YOUR_MAPPLS_API_KEY_HERE
MAPPLS_CLIENT_ID=YOUR_CLIENT_ID_HERE
MAPPLS_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# Firebase Configuration (Optional - Phase 2)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_DATABASE_URL=

# Server Configuration
HOST=0.0.0.0
PORT=8000
