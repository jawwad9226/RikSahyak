/**
 * Firestore Rules (local emulator - no auth needed)
 * Production rules must be added later.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow all reads/writes in emulator (no auth)
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
